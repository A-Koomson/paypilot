# PayPilot environment template. Copy to `.env` for local development.
# NEVER commit real values. `.env` is git-ignored.

# --- Django ----------------------------------------------------------------
# Dev settings are the default for manage.py. Production servers use config.settings.prod.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://paypilot:paypilot@127.0.0.1:5432/paypilot
# Used by docker-compose.yml for the local Postgres container
POSTGRES_USER=paypilot
POSTGRES_PASSWORD=paypilot
POSTGRES_DB=paypilot
POSTGRES_PORT=5432

# --- Frontend / CORS / CSRF ---------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Vite dev proxy target for /api (frontend/.env.local can override)
VITE_API_PROXY_TARGET=http://localhost:8000
# Leave empty to use same-origin /api (recommended; Vercel rewrites /api to the backend)
VITE_API_BASE_URL=

# --- Sessions ---------------------------------------------------------------
SESSION_IDLE_SECONDS=7200
SESSION_ABSOLUTE_SECONDS=86400

# --- Email (required for real delivery) -----------------------------------------
# Without EMAIL_HOST, development prints emails to the backend console and the UI says so.
# Production without EMAIL_HOST delivers nothing and the UI says so.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=PayPilot <no-reply@example.com>
# Preferred on Render. HTTPS to api.resend.com; SMTP ports are often blocked.
RESEND_API_KEY=

# --- Google OAuth (optional; button hidden when unset) -----------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# e.g. http://localhost:5173/api/auth/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=

# --- PayPal (server-side only; sandbox) -------------------------------------------
# Create a Sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
# and enable "Transaction Search" (and Invoicing) for that app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SYNC_LOOKBACK_DAYS=90

# --- AI provider (server-side only) --------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint that supports tool calling.
# Default base URL is Google's Gemini OpenAI-compatible endpoint; confirm the current model
# name and your free-tier limits in the provider console before use.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_CALLS=4
AGENT_CONVERSATION_RETENTION_DAYS=30

# --- Production only -------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SECURE_SSL_REDIRECT=true
# API_DOCS_ENABLED=false
